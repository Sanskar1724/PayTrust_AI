# PayTrust AI — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env — it is gitignored

# ── App ──
APP_NAME=PayTrust AI
APP_VERSION=0.1.1
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-string-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── API Service (api/) ──
# Leave empty in dev → a deterministic dev key is derived from SECRET_KEY.
# In production set a strong random value + explicit CORS allowlist.
PAYTRUST_API_KEY=
CORS_ALLOW_ORIGINS=*

# ── Database (SQLite — local, no Postgres needed for Phase 1-10) ──
# Default: file-based SQLite in ./data/paytrust.db
DATABASE_URL=sqlite:///./data/paytrust.db

# ── Razorpay (TEST MODE ONLY) — keep empty to run fully offline ──
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── LLM Providers (at least one required for AI features; app works without) ──
# Priority: OpenRouter → Groq → Gemini → Deterministic fallback
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-27b-it:free
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Circuit Breaker ──
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=60
CB_HALF_OPEN_MAX_CALLS=3

# ── Rate Limiting ──
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ── Risk thresholds (documented, not magic numbers) ──
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_MEDIUM=60
RISK_THRESHOLD_HIGH=80

# ── Cost Model (SIMULATED assumptions — clearly labeled) ──
FP_CUSTOMER_FRICTION_COST=100.0
FP_LOST_TRANSACTION_VALUE_MULTIPLIER=1.0
FP_SUPPORT_COST=50.0
FP_MERCHANT_IMPACT_COST=200.0
FN_FRAUD_EXPOSURE_MULTIPLIER=1.0

# ── Webhook ──
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=5
WEBHOOK_DLQ_MAX_SIZE=1000
