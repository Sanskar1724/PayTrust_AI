# PayTrust AI configuration. Copy to `.env` (never commit it).
# Every setting has a safe development default; see backend/app/config.py for the full list.

# ── App ──
ENVIRONMENT=development                  # development | staging | production
SECRET_KEY=replace-with-64-random-chars  # python -c "import secrets; print(secrets.token_urlsafe(48))"
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8000
LOG_LEVEL=INFO

# ── First admin (created only when no operator exists) ──
ADMIN_EMAIL=admin@paytrust.local
ADMIN_PASSWORD=change-me-please
SEED_DEMO_DATA=true                      # demo users, agents, merchants, policies on an empty database

# ── Infrastructure ──
# Local default is SQLite in backend/data/. Production: PostgreSQL.
# DATABASE_URL=postgresql+psycopg://paytrust:paytrust@localhost:5432/paytrust
# REDIS_URL=redis://localhost:6379/0     # shared rate limits + live feed across instances

# ── Rules ──
SPEND_TIMEZONE=Asia/Kolkata              # what "today" means for daily limits
APPROVAL_TTL_MINUTES=30
RATE_LIMIT_REQUESTS=120                  # per API key / operator, per window
RATE_LIMIT_WINDOW_SECONDS=60

# ── Agent callbacks ──
# Callbacks may only reach public addresses. Set true ONLY on a dev machine whose test agent
# listens on localhost; production refuses to start with it on.
CALLBACK_ALLOW_PRIVATE_NETWORKS=false
CALLBACK_MAX_ATTEMPTS=8                  # deliveries (with backoff) before a callback is dead-lettered

# ── Background jobs (orders, AI explanations, callbacks) ──
JOBS_WORKER_IN_APP=true                  # false: run `python -m app.cli worker` separately
JOB_MAX_ATTEMPTS=8                       # retries back off 5 s, 10 s, 20 s … up to 10 min

# ── Razorpay ──
RAZORPAY_MODE=simulated                  # simulated | test (rzp_test_*) | live (rzp_live_*)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── AI explanations (optional; deterministic fallback without keys) ──
AI_AUTO_INVESTIGATE=true
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
