# PayTrust AI — Streamlit Community Cloud secrets template.
# DO NOT put real values here. In the Cloud dashboard go to your app →
# Settings → Secrets, paste the TOML below with real values, Save, Reboot.
# Local runs ignore this file entirely (they use .env, which is gitignored).
# Only set what you need — the app runs fully offline without any keys
# (AI falls back to deterministic explanations, Razorpay to SIMULATED mode).

# --- LLM (at least one for live AI investigation; else deterministic fallback) ---
# Priority: OpenRouter → Groq → Gemini → deterministic.
OPENROUTER_API_KEY = ""
OPENROUTER_MODEL = "google/gemma-4-31b-it:free"
# OPENROUTER_FALLBACK_MODELS = "google/gemma-4-26b-a4b-it:free,openrouter/free"
# GROQ_API_KEY = ""
# GEMINI_API_KEY = ""

# --- Razorpay TEST MODE ONLY (never live keys) ---
# RAZORPAY_KEY_ID = "rzp_test_..."
# RAZORPAY_KEY_SECRET = "..."
# RAZORPAY_WEBHOOK_SECRET = "..."

# --- Optional overrides (defaults are Cloud-safe) ---
# SECRET_KEY = "set-a-long-random-string-for-cloud-sessions"
# ENVIRONMENT = "production"
